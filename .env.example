# Entertainment Discovery Rebellion - Environment Variables
# Copy this file to .env and fill in your actual API keys

# Watchmode API Key (https://api.watchmode.com/)
# Required for real-time streaming availability data
WATCHMODE_API_KEY=your_watchmode_api_key_here

# TMDB API Key (https://www.themoviedb.org/settings/api)
# Required for movie/TV metadata, posters, and ratings
TMDB_API_KEY=your_tmdb_api_key_here

# Memory Server URL (optional - defaults to http://localhost:3001)
# Only change if running memory server on different port
MEMORY_SERVER_URL=http://localhost:3001

# Optional: Additional API Keys for fallback sources
# STREAMING_AVAILABILITY_API_KEY=your_streaming_availability_key_here
# OMDB_API_KEY=your_omdb_key_here