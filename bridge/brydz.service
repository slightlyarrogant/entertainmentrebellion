[Unit]
Description=Stolik brydzowy (MCP + strona)
After=network.target

[Service]
WorkingDirectory=/opt/brydz/bridge
Environment=PORT=8765
Environment=HOST=127.0.0.1
Environment=BRIDGE_STATE=/var/lib/brydz
EnvironmentFile=/etc/brydz.env
ExecStart=/opt/brydz/venv/bin/python mcp_server.py
Restart=on-failure
User=brydz
# Izolacja: usługa widzi tylko własny katalog stanu i nie może podnieść uprawnień.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
ReadWritePaths=/var/lib/brydz
InaccessiblePaths=-/srv -/root -/home

[Install]
WantedBy=multi-user.target
